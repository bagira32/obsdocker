      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "none", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "redis_uptime_in_seconds", "legendFormat": "uptime" }]
    },
    {
      "type": "timeseries",
      "title": "Commands processed (ops/sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 5,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "ops/sec" }]
