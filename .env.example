# Copy this file to .env and fill in any values marked <fill-in>.
# Version pins and defaults are pre-filled; only KAFKA_CLUSTER_ID needs generation.

# --- Image versions ---
ELASTIC_VERSION=8.15.3
KIBANA_VERSION=8.15.3
KAFKA_VERSION=7.7.1
CONNECT_VERSION=7.7.1
ES_CONNECTOR_VERSION=14.1.1
FLUENTBIT_VERSION=3.1.9
GRAFANA_VERSION=11.3.0
KAFKA_UI_VERSION=v0.7.2
FLOG_VERSION=0.4.3
REDIS_VERSION=7.4-alpine
REDIS_EXPORTER_VERSION=v1.66.0
PROMETHEUS_VERSION=v3.0.1

# --- Resources ---
ES_HEAP=1g
KAFKA_HEAP=512m

# --- Kafka cluster identity (KRaft mode — must be stable across broker restarts) ---
# Generate once with: docker run --rm confluentinc/cp-kafka:7.7.1 kafka-storage random-uuid
KAFKA_CLUSTER_ID=<fill-in>

# --- Host bind address (keep on 127.0.0.1 unless you've added auth/TLS) ---
BIND=127.0.0.1
